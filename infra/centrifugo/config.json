{
  "token_hmac_secret_key": "torra-centrifugo-secret-key-dev",
  "admin": true,
  "admin_password": "torra_admin",
  "admin_secret": "torra-admin-secret-dev",
  "api_key": "torra-api-key-dev",
  "allowed_origins": ["http://localhost:3000", "http://localhost:8080"],
  "health": true,
  "prometheus": true,
  "log_level": "debug",
  "log_pretty": true,
  "websocket": true,
  "sockjs": true,
  "uni_websocket": true,
  "uni_sse": true,
  "uni_http_stream": true,
  "uni_grpc": true,
  "namespaces": [
    {
      "name": "chat",
      "presence": true,
      "join_leave": true,
      "history_size": 100,
      "history_ttl": "24h",
      "recover": true
    },
    {
      "name": "notifications",
      "presence": false,
      "join_leave": false,
      "publish": true
    },
    {
      "name": "tracking",
      "presence": true,
      "join_leave": false,
      "publish": true
    }
  ],
  "engine": "redis",
  "redis": {
    "address": "redis:6379",
    "db": 1,
    "use_lists": true,
    "prefix": "centrifugo"
  }
}
